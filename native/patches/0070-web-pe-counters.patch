+extern "C" unsigned DolphinWeb_PeCounter(int which)
+{
+  using namespace PixelEngine;
+  switch (which)
+  {
+  case 0: return g_web_pe_finish_calls.load(std::memory_order_relaxed);
+  case 1: return g_web_pe_token_calls.load(std::memory_order_relaxed);
+  case 2: return g_web_pe_finish_irq.load(std::memory_order_relaxed);
+  case 3: return g_web_pe_token_irq.load(std::memory_order_relaxed);
