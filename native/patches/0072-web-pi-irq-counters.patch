+// wiionline (Patch 0072): Zaehler gesetzter Interrupts je Ursache (Bit 0..14), nur Diagnose.
+std::atomic<u32> g_web_pi_irq_set[16];
+
 void ProcessorInterfaceManager::SetInterrupt(u32 cause_mask, bool set)
 {
+  if (set && cause_mask != 0 && (cause_mask & (cause_mask - 1)) == 0)
+  {
+    for (u32 b = 0; b < 16; ++b)
+      if (cause_mask == (1u << b))
+        g_web_pi_irq_set[b].fetch_add(1, std::memory_order_relaxed);
+  }
+
   DEBUG_ASSERT_MSG(POWERPC, Core::IsCPUThread(), "SetInterrupt from wrong thread");
 
