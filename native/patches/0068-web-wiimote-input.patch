+// wiionline: Web-Eingabe-Override (siehe docs/wiimote-input-proposal.md). Der Browser-Worker setzt einen
+// Zustand pro Slot; BuildDesiredWiimoteState uebernimmt Tasten, Beschleunigung und IR-Punkte daraus.
+namespace
+{
+struct WebWiimoteSlot
+{
+  bool active = false;
+  std::uint32_t buttons = 0;  // Web-Maske (Bits siehe WebButtonsToHex)
+  float px = 0.5f, py = 0.5f;
+  bool visible = false;
+  float ax = 0.f, ay = 0.f, az = 1.f;  // in g
+  std::uint32_t generation = 0;        // zaehlt SetWiimote/ClearWiimote
+  std::uint32_t build_count = 0;       // BuildDesiredWiimoteState-Laeufe mit aktivem Override
+  std::uint32_t dbg_hex = 0;
+  std::uint32_t dbg_acc[3] = {};
+  std::uint32_t dbg_pt[4] = {};   // x | y << 16 (0xffff = nicht sichtbar)
+  std::uint32_t dbg_size[4] = {};
+};
+std::mutex s_web_wiimote_mutex;
+std::array<WebWiimoteSlot, 4> s_web_wiimote_slots;
+
+std::uint16_t WebButtonsToHex(std::uint32_t m)
+{
+  std::uint16_t h = 0;
+  if (m & 0x001) h |= 0x0800;  // A
+  if (m & 0x002) h |= 0x0400;  // B
+  if (m & 0x004) h |= 0x0200;  // ONE
+  if (m & 0x008) h |= 0x0100;  // TWO
+  if (m & 0x010) h |= 0x0010;  // PLUS
+  if (m & 0x020) h |= 0x1000;  // MINUS
+  if (m & 0x040) h |= 0x8000;  // HOME
+  if (m & 0x080) h |= 0x0008;  // UP
+  if (m & 0x100) h |= 0x0004;  // DOWN
+  if (m & 0x200) h |= 0x0001;  // LEFT
+  if (m & 0x400) h |= 0x0002;  // RIGHT
+  return h;
+}
+}  // namespace
 
