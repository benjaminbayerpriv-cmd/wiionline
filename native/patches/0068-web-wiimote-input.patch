+// ---------------------------------------------------------------------------
+// wiionline: C-ABI fuer den Browser-Worker (Besitz: Kern-Zweig).
+// Slot 0..3 (bisher nur Slot 0 vom Adapter benutzt). Ungueltiger Slot: kein Effekt.
+// ---------------------------------------------------------------------------
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#define WIIONLINE_EXPORT EMSCRIPTEN_KEEPALIVE
+#else
+#define WIIONLINE_EXPORT
+#endif
+
+static float WebClamp(float v, float lo, float hi, float fallback)
+{
+  if (std::isnan(v))
+    return fallback;
+  return std::clamp(v, lo, hi);
+}
+
+extern "C"
+{
+// buttons: Bitmaske 0x001 A, 0x002 B, 0x004 ONE, 0x008 TWO, 0x010 PLUS, 0x020 MINUS, 0x040 HOME,
+// 0x080 UP, 0x100 DOWN, 0x200 LEFT, 0x400 RIGHT; unbekannte Bits werden ignoriert.
+// pointer_x/y: 0..1, Ursprung oben links; NaN => Zeiger unsichtbar. accel in g (NaN => 0,0,1 je Achse
+// neutral), auf +-8 g begrenzt. Danach ist der Override fuer den Slot aktiv.
+WIIONLINE_EXPORT void WiiOnline_SetWiimote(int slot, std::uint32_t buttons, float pointer_x,
+                                           float pointer_y, int pointer_visible, float accel_x,
+                                           float accel_y, float accel_z)
+{
+  if (slot < 0 || slot >= 4)
+    return;
+  const bool px_nan = std::isnan(pointer_x), py_nan = std::isnan(pointer_y);
+  const std::lock_guard<std::mutex> lock(s_web_wiimote_mutex);
+  WebWiimoteSlot& s = s_web_wiimote_slots[slot];
+  s.active = true;
+  s.buttons = buttons & 0x7ffu;
+  s.px = WebClamp(pointer_x, 0.f, 1.f, 0.5f);
+  s.py = WebClamp(pointer_y, 0.f, 1.f, 0.5f);
+  s.visible = pointer_visible != 0 && !px_nan && !py_nan;
+  s.ax = WebClamp(accel_x, -8.f, 8.f, 0.f);
+  s.ay = WebClamp(accel_y, -8.f, 8.f, 0.f);
+  s.az = WebClamp(accel_z, -8.f, 8.f, 1.f);
+  s.generation++;
+}
+
+// Beendet den Override: Dolphins eigene Konfiguration gilt wieder; gehaltene Tasten sind weg.
+WIIONLINE_EXPORT void WiiOnline_ClearWiimote(int slot)
+{
+  if (slot < 0 || slot >= 4)
+    return;
+  const std::lock_guard<std::mutex> lock(s_web_wiimote_mutex);
+  WebWiimoteSlot& s = s_web_wiimote_slots[slot];
+  const std::uint32_t gen = s.generation + 1;
+  s = WebWiimoteSlot{};
+  s.generation = gen;
+}
+
+// Schreibt 16 uint32 nach out (Puffer >= 64 Byte) und liefert 16; bei ungueltigem Slot oder out==nullptr 0.
+// [0] active (0/1)   [1] generation   [2] build_count (BuildDesiredWiimoteState-Laeufe mit Override)
+// [3] zuletzt gebaute ButtonData.hex   [4..6] Beschleunigung x,y,z (10 Bit)
+// [7..10] IR-Punkt 0..3 als x | y<<16 (0xffff/0xffff = nicht sichtbar)   [11..14] Punktgroessen
+// [15] gesetzte Web-Tastenmaske. Werte [3..14] sind 0, solange build_count == 0.
+WIIONLINE_EXPORT std::uint32_t WiiOnline_GetWiimoteDebug(int slot, std::uint32_t* out)
+{
+  if (slot < 0 || slot >= 4 || out == nullptr)
+    return 0;
+  const std::lock_guard<std::mutex> lock(s_web_wiimote_mutex);
+  const WebWiimoteSlot& s = s_web_wiimote_slots[slot];
+  out[0] = s.active ? 1 : 0;
+  out[1] = s.generation;
+  out[2] = s.build_count;
+  out[3] = s.dbg_hex;
+  for (int i = 0; i < 3; ++i)
+    out[4 + i] = s.dbg_acc[i];
+  for (int i = 0; i < 4; ++i)
+  {
+    out[7 + i] = s.dbg_pt[i];
+    out[11 + i] = s.dbg_size[i];
+  }
+  out[15] = s.buttons;
+  return 16;
+}
+
+// Testzugang: ruft den echten Wiimote::PrepareInput-/BuildDesiredWiimoteState-Pfad der emulierten
+// Remote auf (die BT-Verbindung des Gastes ist dafuer nicht noetig) und liefert das Ergebnis.
+// out: 16 uint32: [0] ButtonData.hex  [1..3] Beschleunigung x,y,z (10 Bit)  [4..7] IR-Punkt 0..3 als
+// x | y<<16 (0xffff = nicht sichtbar)  [8..11] Punktgroessen  [12] GetCurrentlyPressedButtons().hex
+// [13..15] 0. Rueckgabe 1 = ok, 0 = ungueltiger Slot/keine emulierte Wiimote/out==nullptr.
+// Nur fuer Tests; laeuft im aufrufenden Thread (nicht synchron mit dem CPU-Thread).
+WIIONLINE_EXPORT int WiiOnline_TestPrepareInput(int slot, std::uint32_t* out)
+{
+  if (slot < 0 || slot >= 4 || out == nullptr)
+    return 0;
+  ::InputConfig* config = ::Wiimote::GetConfig();
+  if (config == nullptr || slot >= config->GetControllerCount())  // GetController wirft sonst (kein Exception-Support => Abbruch)
+    return 0;
+  auto* wiimote = dynamic_cast<WiimoteEmu::Wiimote*>(config->GetController(slot));
+  if (wiimote == nullptr)
+    return 0;
+  WiimoteEmu::DesiredWiimoteState state;
+  wiimote->PrepareInput(&state, WiimoteCommon::HIDWiimote::SensorBarState::Enabled);
+  for (int i = 0; i < 16; ++i)
+    out[i] = 0;
+  out[0] = state.buttons.hex;
+  out[1] = state.acceleration.value.x;
+  out[2] = state.acceleration.value.y;
+  out[3] = state.acceleration.value.z;
+  for (int i = 0; i < 4; ++i)
+  {
+    out[4 + i] = std::uint32_t(state.camera_points[i].position.x) |
+                 (std::uint32_t(state.camera_points[i].position.y) << 16);
+    out[8 + i] = state.camera_points[i].size;
+  }
+  out[12] = wiimote->GetCurrentlyPressedButtons().hex;
+  return 1;
+}
+}
